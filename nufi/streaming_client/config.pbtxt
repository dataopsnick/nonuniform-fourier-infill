name: "nudft_imputer"
backend: "python"
max_batch_size: 0
dynamic_batching {
    max_queue_delay_microseconds: 500
}

input [
  {
    name: "TIMESTAMPS"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]
output [
  {
    name: "RECONSTRUCTED_SIGNAL"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]